
import turtle

# ===== Screen setting =====
screen = turtle.Screen()
screen.setup(700, 700)
screen.title("Hangman in Turtle")
screen.bgcolor("white")
screen.tracer(0)

pen = turtle.Turtle()
pen.hideturtle()
pen.pensize(3)
pen.speed(0)

# ===== Gallow =====
pen.penup()
pen.goto(-100, -100)
pen.pendown()
pen.goto(100, -100)

pen.penup()
pen.goto(0, -100)
pen.pendown()
pen.goto(0, 150)
pen.goto(80, 150)
pen.goto(80, 120)

# ===== Text panel =====
info = turtle.Turtle()
info.hideturtle()
info.penup()
Meriem = 20245330054
# ===== Game settings =====
word = "python"  # Change this to your own word
guessed = ""
wrong = 0
won = False

# ===== Game loop =====
for attempt in range(6):

    # --- 1. Display word ---
    display = ""

    for letter in word:
        if letter in guessed:
            display += letter + " "
        else:
            display += "_ "

    info.clear()
    info.goto(-300, -200)
    info.write("Word: " + display,
               font=("Arial", 18, "normal"))

    info.goto(-300, -235)
    info.write("Mistakes: " + str(wrong) + " / 6",
               font=("Arial", 14, "normal"))

    screen.update()

    # --- 2. Enter letter ---
    letter = screen.textinput("Hangman", "Your letter:")

    if letter is None:
        letter = ""

    letter = letter.strip().lower()

    # --- 3. Check letter ---
    if len(letter) != 1 or not letter.isalpha():
        info.goto(-300, -270)
        info.write("Please enter ONE letter!",
                   font=("Arial", 12, "italic"))
        screen.update()
        continue

    elif letter in guessed:
        info.goto(-300, -270)
        info.write("You've already entered this letter!",
                   font=("Arial", 12, "italic"))
        screen.update()
        continue

    elif letter in word:
        guessed += letter

    else:
        guessed += letter
        wrong += 1

        # Draw new part of the body
        pen.penup()

        if wrong == 1:          # Head
            pen.goto(80, 80)
            pen.pendown()
            pen.circle(20)

        elif wrong == 2:        # Body
            pen.goto(80, 80)
            pen.pendown()
            pen.goto(80, 40)

        elif wrong == 3:        # Left hand
            pen.goto(80, 70)
            pen.pendown()
            pen.goto(60, 50)

        elif wrong == 4:        # Right hand
            pen.goto(80, 70)
            pen.pendown()
            pen.goto(100, 50)

        elif wrong == 5:        # Left leg
            pen.goto(80, 40)
            pen.pendown()
            pen.goto(60, 10)

        elif wrong == 6:        # Right leg
            pen.goto(80, 40)
            pen.pendown()
            pen.goto(100, 10)

    # --- 4. Check win ---
    win = True

    for letter in word:
        if letter not in guessed:
            win = False
            break

    if win:
        won = True
        break

    screen.update()

# ===== Final display =====
info.clear()
info.goto(-300, -305)

if won:
    info.write("Winner winner chicken dinner! Word is: " + word,
               font=("Arial", 18, "bold"))
else:
    info.write("You lose! Word was: " + word,
               font=("Arial", 18, "bold"))

screen.update()
turtle.done()
